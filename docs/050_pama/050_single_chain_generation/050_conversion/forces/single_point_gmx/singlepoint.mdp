integrator      = md
nsteps          = 0

; Neighbor searching
nstlist         = 1
cutoff-scheme   = Verlet
ns_type         = grid

; Nonbonded
coulombtype     = PME
rcoulomb        = 1.2
vdwtype         = cutoff
rvdw            = 1.2

; Constraints
constraints     = none

; Output control
nstenergy       = 1
nstfout         = 1
nstxout         = 0
nstvout         = 0

; No thermostat/barostat
tcoupl          = no
pcoupl          = no
